        "jsCode": "const messages = $input.first().json.value || [];\n\nreturn messages.map((msg,i) => {\n  const props = msg.singleValueExtendedProperties || [];\n  const works_id = $input.first().json.value[i].singleValueExtendedProperties[0].value;\n  const contract_id = $input.first().json.value[i].singleValueExtendedProperties[1].value;\n  \n  const d = new Date(msg.sentDateTime);\n  const day = String(d.getUTCDate()).padStart(2, '0');\n  const month = String(d.getUTCMonth() + 1).padStart(2, '0');\n  const year = d.getUTCFullYear();\n  \n  return {\n    json: {\n      message_id: msg.id,\n      subject: msg.subject,\n      works_id,\n      contract_id,\n      handover_date: `${day}/${month}/${year}`\n    }\n  };\n});"
