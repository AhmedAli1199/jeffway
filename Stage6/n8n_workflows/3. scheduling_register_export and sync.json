        "jsCode": "const TEMPLATE_NODE = 'Read RR_work_instruction_template_s6';\nconst OJS_NODE = 'Read Operative Job Sheet sync';\n\nconst SYNC_FIELDS = [\n  { template: 'Appointment Date', ojs: 'Appointment Date' },\n  { template: 'Next appointment date', ojs: 'Next appointment date' },\n  { template: 'Completed', ojs: 'Completed' },\n  { template: 'Internal Notes', ojs: 'Internal Notes' },\n  { template: 'Ready to handover', ojs: 'Ready To Hand over', onlyIfYes: true },\n  { template: 'BCC Tracker Status', ojs: 'BCC Tracker Status' },\n];\n\nfunction rowsFrom(nodeName) {\n  try {\n    return $(nodeName).all().map((i) => i.json || {});\n  } catch (e) {\n    return [];\n  }\n}\n\nfunction normText(v) {\n  return String(v ?? '')\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, ' ');\n}\n\nfunction normCorf(v) {\n  return String(v ?? '').trim().toUpperCase().replace(/\\s+/g, '');\n}\n\nfunction isYes(v) {\n  const s = String(v ?? '').trim().toLowerCase();\n  return s === 'yes' || s === 'y' || s === 'true' || s === '1';\n}\n\nfunction corfFromQ11Address(addr) {\n  const s = String(addr ?? '').trim();\n  const m = s.match(/-(\\d+\\/\\d+)\\s*$/);\n  return m ? m[1] : '';\n}\n\nfunction corfFromOjsRow(row) {\n  const direct = normCorf(row.CORF ?? row.corf);\n  if (direct) return direct;\n  return normCorf(corfFromQ11Address(row['Q1.1 Address']));\n}\n\nfunction isHeaderRowSmartForm(row) {\n  return /^smartform name$/i.test(String(row['SmartForm Name'] ?? '').trim());\n}\n\nfunction isHeaderRowTemplate(row) {\n  const a = String(row['Received Date and Time'] ?? '').trim();\n  const b = String(row['Client Order Reference'] ?? row['Property Reference'] ?? '').trim();\n  return /^received date and time$/i.test(a) || /^client order reference$/i.test(b) || /^property reference$/i.test(b);\n}\n\nfunction isBccResponseRepairs(name) {\n  return /:\\s*BCC\\s+Respon(?:se|sive)\\s+Repairs\\b/i.test(String(name ?? '').trim());\n}\n\nfunction isEmpty(v) {\n  if (v === null || v === undefined) return true;\n  return String(v).trim() === '';\n}\n\nconst templateRows = rowsFrom(TEMPLATE_NODE).filter((r) => !isHeaderRowTemplate(r));\nconst templateByCorf = new Map();\nconst templateByPropertyRef = new Map();\nlet skippedTemplate = 0;\n\nfor (const row of templateRows) {\n  const corf = normCorf(row['Client Order Reference']);\n  const propRef = normCorf(row['Property Reference']);\n  if (!corf && !propRef) {\n    skippedTemplate++;\n    continue;\n  }\n  if (corf) templateByCorf.set(corf, row);\n  if (propRef) templateByPropertyRef.set(propRef, row);\n}\n\nfunction findTemplateRow(ojsKey) {\n  if (!ojsKey) return { row: null, matchType: null };\n  const byCorf = templateByCorf.get(ojsKey);\n  if (byCorf) return { row: byCorf, matchType: 'corf' };\n  const byProp = templateByPropertyRef.get(ojsKey);\n  if (byProp) return { row: byProp, matchType: 'property_reference' };\n  return { row: null, matchType: null };\n}\n\nconst ojsRows = rowsFrom(OJS_NODE).filter((r) => !isHeaderRowSmartForm(r));\nconst out = [];\nlet ojsSkippedNonBcc = 0;\nlet noTemplateMatch = 0;\nlet noOjsKey = 0;\nlet noChanges = 0;\nlet matchedRows = 0;\nlet matchedByCorf = 0;\nlet matchedByPropertyRef = 0;\n\nfor (const ojsRow of ojsRows) {\n  const name = ojsRow['SmartForm Name'] ?? '';\n  if (!isBccResponseRepairs(name)) {\n    ojsSkippedNonBcc++;\n    continue;\n  }\n\n  const ojsKey = corfFromOjsRow(ojsRow);\n  if (!ojsKey) {\n    noOjsKey++;\n    continue;\n  }\n\n  const { row: templateRow, matchType } = findTemplateRow(ojsKey);\n  if (!templateRow) {\n    noTemplateMatch++;\n    continue;\n  }\n\n  matchedRows++;\n  if (matchType === 'corf') matchedByCorf++;\n  else if (matchType === 'property_reference') matchedByPropertyRef++;\n  const rn = ojsRow.row_number ?? ojsRow.rowNumber;\n  if (rn === null || rn === undefined || rn === '') continue;\n\n  const update = { row_number: rn };\n  let changed = false;\n  for (const field of SYNC_FIELDS) {\n    let newVal = templateRow[field.template];\n    if (field.onlyIfYes) {\n      if (!isYes(newVal)) continue;\n      newVal = 'Yes';\n    } else if (isEmpty(newVal)) {\n      continue;\n    }\n    const oldVal = ojsRow[field.ojs];\n    if (normText(oldVal) !== normText(newVal)) {\n      update[field.ojs] = typeof newVal === 'string' ? newVal.trim() : newVal;\n      changed = true;\n    }\n  }\n\n  if (changed) out.push({ json: update });\n  else noChanges++;\n}\n\nconst stats = {\n  template_rows: templateRows.length,\n  template_corfs: templateByCorf.size,\n  template_property_refs: templateByPropertyRef.size,\n  skipped_template: skippedTemplate,\n  ojs_rows: ojsRows.length,\n  ojs_skipped_non_bcc: ojsSkippedNonBcc,\n  ojs_no_match_key: noOjsKey,\n  matched_rows: matchedRows,\n  matched_by_corf: matchedByCorf,\n  matched_by_property_reference: matchedByPropertyRef,\n  no_template_match: noTemplateMatch,\n  no_changes: noChanges,\n  rows_to_update: out.length,\n};\n\nif (!out.length) {\n  return [{ json: { _skip_update: true, ...stats } }];\n}\n\nout[0].json._sync_stats = stats;\nreturn out;"
      },
