# Playwright: visible browser on the PC running FastAPI (set headless=true only on servers)
headless=false
EASYBOP_KEEP_PAGE_OPEN=true
# Optional: slow down typing/clicks so you can watch (e.g. 50–150)
EASYBOP_SLOW_MO_MS=0
JIS_PRE_ITEM_ITEM_ID=27059
request_timeout_ms=25000

# Only these IPs may call the API (comma-separated). Use * to disable.
API_ALLOWED_IPS=127.0.0.1,::1,144.126.195.119

# API Port configuration
API_PORT=8010
