      "parameters": {
        "jsCode": "const fmt = (function () {\n  try { return $('Format results').first().json || {}; } catch (e) { return {}; }\n})();\nreturn [{\n  json: {\n    message: 'Stalled appointment check complete',\n    as_of: fmt.as_of,\n    months_checked: fmt.months_checked,\n    summary: fmt.summary,\n    email_sent: fmt.email_needed === true,\n    finished_at: new Date().toISOString(),\n  },\n}];"
      },
