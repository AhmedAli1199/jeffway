      "note": "Update ngrok URL; lookback_days default 14"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($('Set API params').first().json.ngrok_base_url || '').replace(/\\/+$/, '') + '/stage5/stalled-appointment-check' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "ngrok-skip-browser-warning",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contract_id: '321129', lookback_days: $('Set API params').first().json.lookback_days ?? 14 } }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "cc2faf7c-c83c-4f53-81ef-0bfe4f7c058d",
      "name": "POST stalled check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        592,
        432
      ],
      "notesInFlow": true,
      "note": "Multi-month EasyBOP export + OJS scrape"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json || {};\nconst summary = r.summary || {};\nconst returning = r.returning_next_day || [];\nconst review = r.needs_review || [];\nconst emailCount = summary.email_count ?? (returning.length + review.length);\n\nreturn [{\n  json: {\n    ok: true,\n    as_of: r.as_of,\n    months_checked: r.months_checked || [],\n    summary,\n    returning_next_day: returning,\n    needs_review: review,\n    email_needed: emailCount > 0,\n    _alert_subject: r.email_subject || ('Stage 5 Stalled Appointments — ' + emailCount + ' item(s)'),\n    _alert_html: r.email_html || '<p>No email HTML returned from API.</p>',\n    finished_at: new Date().toISOString(),\n  },\n}];"
      },
      "id": "4232e7e5-84e1-4955-b7f0-61341a1cebdd",
      "name": "Format results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
