    {
      "parameters": {
        "jsCode": "const ai = $('Final AI Scoring2').first().json;\nconst score = $('Score SOR Descriptions agains Worker Description2').first().json;\nconst loop = $('Loop Over Items4').item.json;\n\nconst parsed = ai.output?.[0]?.content?.[0]?.text ?? {};\nconst code = parsed.code ?? parsed.document_code;\nconst quantity = Number(parsed.quantity ?? 1) || 1;\n\nconst candidates = Array.isArray(score.top_candidates) ? score.top_candidates : [];\nconst matched = candidates.find((item) => String(item.document_code) === String(code));\nconst fallback = candidates.length ? candidates[candidates.length - 1] : null;\nconst sorDescription = (matched || fallback)?.short_description || '';\n\nconst smartFormName = String(loop['SmartForm Name'] ?? '');\nconst address = smartFormName.split(':')[0].trim();\n\nreturn [{\n  json: {\n    address,\n    days: 2,\n    subject: 'Test Variation',\n    sor_ref: String(code ?? ''),\n    quantity,\n    sor_description: sorDescription,\n    worker_description: String(score.worker_description ?? ''),\n  },\n}];"
      },
