    {
      "parameters": {
        "jsCode": "// Filter to only valid PDF attachments not already present in SharePoint.\n// SharePoint folder listing is the sole source of truth — no DataTable needed.\nconst emails = $('Dedupe Messages').all();\nconst fetches = $input.all();\nconst spFiles = $('List SP Asbestos Folder').first().json.value || [];\n\n// Build a lowercase set of filenames already in SharePoint\nconst spNames = new Set(spFiles.map(f => String(f.name || '').toLowerCase()));\n\nconst results = [];\n\nfor (let i = 0; i < fetches.length; i++) {\n  const email = emails[i]?.json || {};\n  if (email._no_messages) continue;\n\n  const attachments = fetches[i].json.value || [];\n\n  const pdfs = attachments.filter(a => {\n    const name = String(a.name || '');\n    if (!name.toLowerCase().endsWith('.pdf')) return false;\n    // Skip attachments with hash-like names (system-generated)\n    const stem = name.replace(/\\.pdf$/i, '');\n    if (/^[0-9a-f]{20,}$/i.test(stem)) return false;\n    return true;\n  });\n\n  for (const p of pdfs) {\n    const fileName = String(p.name || '').trim();\n\n    // Skip if file already exists in SharePoint\n    if (spNames.has(fileName.toLowerCase())) {\n      console.log(`SKIP (already in SP): ${fileName}`);\n      continue;\n    }\n\n    results.push({\n      json: {\n        ...p,\n        email_id: String(email.id || '').trim(),\n        email_subject: email.subject || '',\n        email_from: email.from?.emailAddress?.address || '',\n        email_received: email.receivedDateTime || '',\n        message_source: email.message_source || '',\n        mailbox_folder_path: email.mailbox_folder_path || '',\n        sharepoint_upload_folder: email.sharepoint_upload_folder || 'RR Job imports and JIS/Asbestos reports'\n      }\n    });\n  }\n}\n\nif (!results.length) {\n  return [{ json: { _no_new_pdfs: true } }];\n}\n\nconsole.log(`New PDFs to upload: ${results.length}`);\nreturn results;"
      },
