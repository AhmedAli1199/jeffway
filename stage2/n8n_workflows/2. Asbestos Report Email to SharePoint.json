    {
      "parameters": {
        "jsCode": "const mailbox = 'BCCorders@jeffway.co.uk';\nconst resp = $input.first().json || {};\nconst status = resp.statusCode ?? 200;\nconst body = resp.body ?? resp;\nconst folders = (status >= 200 && status < 300) ? (body.value || []) : [];\nconst inbox = folders.find(f => /^inbox$/i.test(String(f.displayName || '').trim()));\n\nif (!inbox) {\n  return [{ json: { ok: false, mailbox, error: 'Inbox not found' } }];\n}\n\nreturn [{ json: { ok: true, mailbox, inbox_id: inbox.id } }];"
      },
