    {
      "parameters": {
        "jsCode": "// Tag Asbestos subfolder messages with source label\nconst SP_FOLDER = 'RR Job imports and JIS/Asbestos reports';\nlet msgs = [];\nlet folderPath = 'Inbox/Asbestos';\ntry {\n  const ar = $('Fetch Asbestos Folder Messages').first().json;\n  msgs = ar?.value || ar?.body?.value || [];\n  folderPath = $('Pick Asbestos Folder').first().json.folder_path || folderPath;\n} catch (e) {\n  msgs = [];\n}\n\nif (!msgs.length) {\n  return [{ json: { _merge_placeholder: true } }];\n}\n\nreturn msgs.map(m => ({\n  json: {\n    ...m,\n    message_source: 'asbestos_folder',\n    mailbox_folder_path: folderPath,\n    sharepoint_upload_folder: SP_FOLDER\n  }\n}));"
      },
