        "responses": {
          "values": [
            {
              "content": "=You are matching a maintenance worker's free-text job description to a Schedule of Rates (SOR) code.\n\nPart 1:\nA maintenance worker wrote: \"{{ $json.worker_description }}\"\n\nThese are the top matching SOR codes:\n{{ JSON.stringify($json.top_candidates, null, 2) }}\n\nPART 2 — Extract quantity:\nRead the worker's description given above and extract any quantity mentioned (e.g. \"2 windows\", \"3 doors\", \"replaced 4 vents\"). If a specific number is mentioned, use it. If no quantity is mentioned, use 1.\n\n\nReturn ONLY a valid JSON object in this exact format, nothing else:\n{\n  \"document_code\": 318105,\n  \"quantity\": 1\n}\n\nNo explanation, no extra text.\n\n"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"code\": {\n      \"type\": \"number\"\n    },\n    \"quantity\":{\n      \"type\": \"number\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\"code\",\"quantity\" ]\n}"
            }
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
