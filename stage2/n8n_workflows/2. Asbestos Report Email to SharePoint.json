    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base64Data = String($json.contentBytes || '').trim();\nconst fileName = String($json.name || 'report.pdf').trim();\nconst mimeType = $json.contentType || 'application/pdf';\nconst driveId = $('Get BCC Library Drive').first().json.id;\n\n// Graph returns no contentBytes for reference/link attachments — skip gracefully\nif (!base64Data) {\n  console.log(`SKIP (no contentBytes — likely a link attachment): ${fileName}`);\n  return null;\n}\n\nconst buffer = Buffer.from(base64Data, 'base64');\nif (buffer.length < 256) {\n  console.log(`SKIP (PDF too small, likely corrupt): ${fileName} (${buffer.length} bytes)`);\n  return null;\n}\n\nconst binary = await this.helpers.prepareBinaryData(buffer, fileName, mimeType);\n\nreturn {\n  json: {\n    drive_id: driveId,\n    pdf_file_name: fileName,\n    pdf_bytes: buffer.length\n  },\n  binary: {\n    attachment_0: binary\n  }\n};"
      },
