    {
      "parameters": {
        "jsCode": "// Deduplicate messages by email ID, merging source labels for messages that appear in both folders\nconst items = $input.all().map(i => i.json).filter(j => j && !j._merge_placeholder);\nconst seen = new Map();\n\nfor (const m of items) {\n  if (!m?.id) continue;\n  const existing = seen.get(m.id);\n  if (!existing) {\n    seen.set(m.id, m);\n    continue;\n  }\n  const sources = new Set([existing.message_source, m.message_source].filter(Boolean));\n  seen.set(m.id, {\n    ...existing,\n    ...m,\n    message_source: sources.size > 1 ? 'both' : (m.message_source || existing.message_source),\n    mailbox_folder_path: [...new Set([existing.mailbox_folder_path, m.mailbox_folder_path].filter(Boolean))].join(' | ')\n  });\n}\n\nconst merged = [...seen.values()];\nmerged.sort((a, b) => String(b.receivedDateTime || '').localeCompare(String(a.receivedDateTime || '')));\n\nif (!merged.length) return [];\n\nreturn merged.map(m => ({ json: m }));"
      },
