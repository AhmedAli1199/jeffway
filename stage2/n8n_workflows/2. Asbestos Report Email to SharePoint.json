      "parameters": {
        "jsCode": "const seed = $('Find Inbox').first().json;\nconst resp = $input.first().json || {};\nconst status = resp.statusCode ?? 200;\nconst body = resp.body ?? resp;\nconst children = (status >= 200 && status < 300) ? (body.value || []) : [];\nconst needle = 'asbestos';\nconst norm = s => String(s || '').trim().toLowerCase();\n\nconst match = children.find(c => norm(c.displayName).includes(needle));\n\nif (!match) {\n  return [{ json: {\n    ok: false,\n    mailbox: seed.mailbox,\n    error: 'No Inbox subfolder matching asbestos',\n    inbox_child_names: children.map(c => c.displayName)\n  }}];\n}\n\nreturn [{ json: {\n  ok: true,\n  mailbox: seed.mailbox,\n  folder_id: match.id,\n  folder_path: `Inbox/${match.displayName}`\n}}];"
      },
