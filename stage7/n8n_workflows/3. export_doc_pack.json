    {
      "parameters": {
        "jsCode": "const SOURCE = 'Read RR_work_instruction_template_s6';\n\nfunction rowsFrom(name) {\n  try { return $(name).all().map((i) => i.json || {}); } catch (e) { return []; }\n}\n\nfunction isYes(v) {\n  const s = String(v ?? '').trim().toLowerCase();\n  return s === 'yes' || s === 'y' || s === 'true' || s === '1';\n}\n\nfunction isHeader(row) {\n  const received = String(row['Received Date and Time'] ?? '').trim();\n  const address = String(row['Address'] ?? '').trim();\n  return /^received date/i.test(received) || /^address$/i.test(address);\n}\n\nconst rows = rowsFrom(SOURCE).filter((r) => !isHeader(r));\nconst queue = [];\n\nfor (const row of rows) {\n  if (!isYes(row['Ready to handover'])) continue;\n  if (!isYes(row['QS Reviewed'])) continue;\n  if (isYes(row['Handover Processed'])) continue;\n  if (!String(row['Address'] ?? '').trim()) continue;\n  \n  queue.push(row);\n}\n\nif (!queue.length) {\n  return [{ json: { _workflow_only: true, _no_jobs: true, message: 'No RR rows with Ready to handover=Yes and QS Reviewed=Yes', eligible: 0 } }];\n}\n\nreturn queue.map((row, i) => ({\n  json: {\n    ...row,\n    _job_index: i + 1,\n    _job_total: queue.length,\n  },\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        352
      ],
