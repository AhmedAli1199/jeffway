      "parameters": {
        "jsCode": "// Tag Inbox messages with source label\nconst SP_FOLDER = 'RR Job imports and JIS/Asbestos reports';\nconst msgs = $('Fetch Inbox Messages').first().json.value || [];\nreturn msgs.map(m => ({\n  json: {\n    ...m,\n    message_source: 'inbox',\n    mailbox_folder_path: 'Inbox',\n    sharepoint_upload_folder: SP_FOLDER\n  }\n}));"
