        "jsCode": "function safeFirst(nodeName) {\n  try {\n    return $(nodeName).first()?.json || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction safeAll(nodeName) {\n  try {\n    return $(nodeName).all().map((i) => i.json || {});\n  } catch (e) {\n    return [];\n  }\n}\n\nconst buildItems = safeAll('Build WI \u2192 OJS updates');\nconst buildFirst = buildItems[0] || {};\nconst stats = buildFirst._sync_stats || buildFirst;\nconst skip = buildFirst._skip_update === true;\n\nlet updated = 0;\ntry {\n  updated = $('Update Operative Job Sheet from WI').all().length;\n} catch (e) {\n  updated = skip ? 0 : buildItems.filter((j) => !j._skip_update).length;\n}\n\nconst rowsToUpdate = stats.rows_to_update ?? (skip ? 0 : buildItems.filter((j) => !j._skip_update).length);\nconst matched = stats.matched_rows ?? 0;\n\nlet message = '';\nif (rowsToUpdate === 0) {\n  if (matched > 0) {\n    message = `Matched ${matched} OJS row(s); all WI fields already up to date.`;\n  } else {\n    message = 'No OJS rows matched template (check Client Order Reference \u2194 CORF, or Property Reference fallback).';\n  }\n} else {\n  message = `Updated ${updated || rowsToUpdate} OJS row(s) from WI template.`;\n}\n\nreturn [{\n  json: {\n    ok: rowsToUpdate > 0,\n    message,\n    rows_updated: updated || rowsToUpdate,\n    matched_rows: matched,\n    no_changes: stats.no_changes ?? 0,\n    no_template_match: stats.no_template_match ?? 0,\n    template_corfs: stats.template_corfs ?? stats.template_keys ?? 0,\n    template_property_refs: stats.template_property_refs ?? 0,\n    matched_by_corf: stats.matched_by_corf ?? 0,\n    matched_by_property_reference: stats.matched_by_property_reference ?? 0,\n    ojs_rows: stats.ojs_rows ?? 0,\n  },\n}];"
