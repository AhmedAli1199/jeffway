    {
      "parameters": {
        "jsCode": "const SOURCE = 'Get All completed and variations jobs2';\n\nfunction rowsFrom(name) {\n  try { return $(name).all().map((i) => i.json || {}); } catch (e) { return []; }\n}\n\nfunction isHeader(row) {\n  return /^smartform name$/i.test(String(row['SmartForm Name'] ?? '').trim());\n}\n\nfunction isNoOrEmpty(v) {\n  const s = String(v ?? '').trim();\n  if (!s) return true;\n  const low = s.toLowerCase();\n  return low === 'no' || low === 'n' || low === 'false' || low === '0';\n}\n\nfunction normJobStatus(v) {\n  const s = String(v ?? '').trim().toLowerCase();\n  if (s.startsWith('comp')) return 'completed';\n  return s;\n}\n\nfunction q24Yes(row) {\n  return String(row['Q2.4 Did you complete any additonal work or variations?'] ?? '').trim().toLowerCase() === 'yes';\n}\n\nconst rows = rowsFrom(SOURCE).filter((r) => !isHeader(r));\nconst queue = [];\n\nfor (const row of rows) {\n  if (!q24Yes(row)) continue;\n  if (normJobStatus(row['Job Status']) !== 'completed') continue;\n  if (!isNoOrEmpty(row['Variation Created'])) continue;\n  if (!isNoOrEmpty(row['QS Review Task Created'])) continue;\n  queue.push(row);\n}\n\nif (!queue.length) {\n  return [];\n}\n\nreturn queue.map((row, i) => ({\n  json: {\n    ...row,\n    _job_index: i + 1,\n    _job_total: queue.length,\n  },\n}));\n"
      },
