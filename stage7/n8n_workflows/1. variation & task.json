    {
      "parameters": {
        "jsCode": "// Change 'Webhook' to whatever node name holds the Q2.7 worker description\nconst workerText = $('Loop Over Items4').first().json['Q2.7 Please provide some detail on the variations? Task, QTY, Location. e.g. skimmed extra 3 sqm in lounge.'] ?? '';\nconst TOP_N = 15;\n\n// ── STOPWORDS ────────────────────────────────────────────────────────────────\nconst STOPWORDS = new Set([\n  'the','a','an','to','for','in','of','and','or','with',\n  'ne','any','all','new','existing','both','sides','supply',\n  'lay','take','up','clean','make','good','remove','waste','debris'\n]);\n\n// ── TOKENIZE ─────────────────────────────────────────────────────────────────\nfunction tokenize(text) {\n  return String(text ?? '')\n    .toLowerCase()\n    .replace(/[^a-z0-9\\s]/g, ' ')\n    .split(/\\s+/)\n    .filter(w => w.length > 2 && !STOPWORDS.has(w));\n}\n\nconst queryTokens = tokenize(workerText);\n\n// ── SCORE ALL ROWS ────────────────────────────────────────────────────────────\nconst sorRows = $input.all();\n\nconst scored = sorRows.map(item => {\n  const row = item.json;\n\n  const haystack = [\n    row['Short Description']  ?? '',\n    row['Medium Description'] ?? '',\n    row['Detailed Description'] ?? '',\n    row['Element']    ?? '',\n    row['Section']    ?? '',\n    row['Subsection'] ?? '',\n    row['NHF_Trade_Code'] ?? '',\n  ].join(' ').toLowerCase();\n\n  let score = 0;\n\n  for (const token of queryTokens) {\n    if (haystack.includes(token)) {\n      score++;\n      // Extra weight when token hits the Short Description (most concise)\n      if ((row['Short Description'] ?? '').toLowerCase().includes(token)) {\n        score += 2;\n      }\n    }\n  }\n\n  // Bonus if the full phrase appears verbatim anywhere\n  if (workerText.length > 3 && haystack.includes(workerText.toLowerCase())) {\n    score += 10;\n  }\n\n  return {\n    score,\n    document_code:      row['Document Code'],\n    short_description:  row['Short Description'],\n    medium_description: row['Medium Description'],\n    sor_rate:           row['SOR Rate'],\n    uom:                row['UOM'],\n    trade_code:         row['NHF_Trade_Code'],\n    element:            row['Element'],\n    section:            row['Section'],\n    subsection:         row['Subsection'],\n  };\n});\n\n// ── TOP N ─────────────────────────────────────────────────────────────────────\nconst topCandidates = scored\n  .filter(r => r.score > 0)\n  .sort((a, b) => b.score - a.score)\n  .slice(0, TOP_N);\n\n// Single output item: worker text + ranked candidates for Claude node\nreturn [{\n  json: {\n    worker_description: workerText,\n    top_candidates:     topCandidates,\n    candidate_count:    topCandidates.length,\n  }\n}];"
      },
